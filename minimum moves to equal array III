class Solution {
    public int minMoves(int[] nums) {
      int max=Integer.MIN_VALUE;
      for(int i=0;i<nums.length;i++){
        if(max<nums[i]){
            max=nums[i];
        }
      }  
      int count=0;
      for(int i=0;i<nums.length;i++){
        if(nums[i]<=max){
            for(int j=nums[i];j<max;j++){
                nums[i]++;
                count++;
            }
        }
      }
      return count;
    }
}
